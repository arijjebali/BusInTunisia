# Configuration NON SENSIBLE de l'environnement de TEST (versionnée).
# Les secrets (DB_PASSWORD, DB_ROOT_PASSWORD, JWT_SECRET) ne sont PAS ici : ils viennent des secrets
# de l'environnement GitHub « test » et sont écrits par le pipeline dans un fichier hors du dépôt
# (voir deploy/test/secrets.env.example et docs/devops/05-configuration.md).

COMPOSE_PROJECT_NAME=busintunisia-test
APP_ENV=test
APP_PORT=8080
APP_IMAGE=ghcr.io/arijjebali/busintunisia
DB_IMAGE=mariadb:10.11
DB_NAME=bus_in_tunisia
DB_USER=busintunisia
ENABLE_DEMO_ACCOUNTS=false
LOG_LEVEL=info
