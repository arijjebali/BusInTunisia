# Variables de Docker Compose pour l'environnement de DÉVELOPPEMENT.
# Copier ce fichier en « .env » (ignoré par Git) et remplacer les valeurs « changer-moi ».
# Matrice complète des environnements : docs/devops/05-configuration.md

COMPOSE_PROJECT_NAME=busintunisia-dev
APP_ENV=development
APP_PORT=8000
APP_IMAGE=busintunisia
APP_TAG=local

DB_NAME=bus_in_tunisia
DB_USER=busintunisia
DB_PASSWORD=changer-moi
DB_ROOT_PASSWORD=changer-moi-aussi
JWT_SECRET=changer-moi-par-une-longue-valeur-aleatoire

ENABLE_DEMO_ACCOUNTS=false
LOG_LEVEL=debug
