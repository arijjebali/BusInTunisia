PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bus_in_tunisia
# Obligatoire : le serveur refuse de démarrer sans secret JWT (ANO-15)
JWT_SECRET=changer-moi-par-une-longue-valeur-aleatoire
CLIENT_URL=http://localhost:5173
# Comptes de démonstration (admin@bus.tn / user@bus.tn) : désactivés par défaut (ANO-12)
ENABLE_DEMO_ACCOUNTS=false
# Base dédiée aux tests (doit se terminer par _test)
TEST_DB_NAME=bus_in_tunisia_test
