{
  "name": "server",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "test": "jest tests/unit",
    "test:unit": "jest tests/unit --verbose",
    "test:integration": "jest tests/integration --runInBand --verbose",
    "test:coverage": "node tests/runCoverage.js",
    "test:api": "node tests/api/runApiTests.js --report=complet",
    "test:api:regression": "node tests/api/runApiTests.js --regression --report=regression",
    "test:perf": "node tests/perf/loadTest.js",
    "test:regression": "npm run test:coverage && npm run test:api:regression",
    "db:reset": "node tests/db/resetTestDb.js",
    "lint": "eslint ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "API REST BusInTunisia (Express + MySQL/MariaDB)",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.20.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "autocannon": "^8.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jest": "^29.17.1",
    "globals": "^17.14.0",
    "jest": "^29.7.0",
    "jest-junit": "^17.0.0",
    "newman": "^6.2.3",
    "supertest": "^7.3.2"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "index.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "text-summary",
      "html",
      "json-summary",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 35,
        "branches": 25,
        "functions": 25,
        "lines": 35
      },
      "./src/services/**/*.js": {
        "statements": 90,
        "branches": 85,
        "functions": 90,
        "lines": 90
      },
      "./src/repositories/**/*.js": {
        "statements": 90,
        "branches": 70,
        "functions": 90,
        "lines": 90
      }
    },
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "reports/junit",
          "outputName": "jest-junit.xml",
          "classNameTemplate": "{classname}",
          "titleTemplate": "{title}"
        }
      ]
    ]
  }
}
